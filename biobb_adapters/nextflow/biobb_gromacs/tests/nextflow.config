// Generated by utils_biobb nextflow_generator.py from the JSON schemas: do not edit by hand.
// Test settings of biobb_gromacs: properties and outputs of biobb_gromacs/test/conf.yml

process {
    errorStrategy = 'ignore'
    time = '1h'
    withName: 'BIOBB_GROMACS_APPEND_LIGAND' {
        ext.properties = [posres_name: 'POSRES_LIGAND']
    }
    withName: 'BIOBB_GROMACS_CONVERT_TPR' {
        ext.properties = [nsteps: 100]
    }
    withName: 'BIOBB_GROMACS_EDITCONF' {
        ext.properties = [distance_to_molecule: 1.0, box_type: 'cubic']
        ext.outputs = [output_gro_path: 'gro']
    }
    withName: 'BIOBB_GROMACS_GENION' {
        ext.properties = [concentration: 0.05, replaced_group: 'SOL']
    }
    withName: 'BIOBB_GROMACS_GENRESTR' {
        ext.properties = [restrained_group: 'system', force_constants: '500 500 500']
    }
    withName: 'BIOBB_GROMACS_GMXSELECT' {
        ext.properties = [selection: '"Mynewgroup" group "Protein-H" and not same residue as within 0.4 of resname ARG']
    }
    withName: 'BIOBB_GROMACS_GROMPP' {
        ext.properties = [maxwarn: 1, mdp: ['ld-seed': '1']]
    }
    withName: 'BIOBB_GROMACS_GROMPP_MDRUN' {
        cpus = 4
        ext.properties = [simulation_type: 'free', maxwarn: 1, mdp: ['ld-seed': '1', dt: 0.0001], binary_path: 'gmx']
    }
    withName: 'BIOBB_GROMACS_MAKE_NDX' {
        ext.properties = [selection: 'a C*\n0 & ! 13\nname 14 FREEZE']
    }
    withName: 'BIOBB_GROMACS_MDRUN' {
        cpus = 4
        ext.properties = [binary_path: 'gmx']
        ext.outputs = [output_trr_path: 'trr']
    }
    withName: 'BIOBB_GROMACS_MDRUN_PLUMED' {
        cpus = 4
        ext.properties = [binary_path: 'gmx']
        ext.outputs = [output_trr_path: 'trr']
    }
    withName: 'BIOBB_GROMACS_NDX2RESTTOP' {
        ext.properties = [ref_rest_mol_triplet_list: '( Chain_A, Chain_A_noMut, A ), ( Chain_B, Chain_B_noMut, B ), ( Chain_C, Chain_C_noMut, C ), ( Chain_D, Chain_D_noMut, D )']
    }
    withName: 'BIOBB_GROMACS_PDB2GMX' {
        ext.properties = [his: '0 0 1 1 0 0 0']
    }
    withName: 'BIOBB_GROMACS_SOLVATE' {
        ext.properties = [binary_path: 'gmx', restart: 'False']
    }
    withName: 'BIOBB_GROMACS_TRJCAT' {
        ext.properties = [binary_path: 'gmx', restart: 'False']
        ext.outputs = [output_trj_path: 'trr']
    }
}

trace {
    enabled = true
    file = 'tests_trace.tsv'
    overwrite = true
    fields = 'process,tag,status,exit,realtime'
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    apptainer {
        apptainer.enabled = true
    }
}
