// Generated by utils_biobb nextflow_generator.py from the JSON schemas: do not edit by hand.
// Test settings of biobb_flexserv: properties and outputs of biobb_flexserv/test/conf.yml

process {
    errorStrategy = 'ignore'
    time = '1h'
    withName: 'BIOBB_FLEXSERV_BD_RUN' {
        ext.properties = [time: 10000, wfreq: 100]
    }
    withName: 'BIOBB_FLEXSERV_DMD_RUN' {
        ext.properties = [frames: 100]
    }
    withName: 'BIOBB_FLEXSERV_NMA_RUN' {
        ext.properties = [frames: 100]
    }
    withName: 'BIOBB_FLEXSERV_PCZ_ANIMATE' {
        ext.properties = [eigenvector: 1, pdb: true]
        ext.outputs = [output_crd_path: 'pdb']
    }
    withName: 'BIOBB_FLEXSERV_PCZ_BFACTOR' {
        ext.properties = [eigenvector: 1, pdb: true]
        ext.outputs = [output_pdb_path: 'pdb']
    }
    withName: 'BIOBB_FLEXSERV_PCZ_COLLECTIVITY' {
        ext.properties = [eigenvector: 0]
    }
    withName: 'BIOBB_FLEXSERV_PCZ_EVECS' {
        ext.properties = [eigenvector: 1]
    }
    withName: 'BIOBB_FLEXSERV_PCZ_HINGES' {
        ext.properties = [eigenvector: 0, method: 'Bfactor_slope']
    }
    withName: 'BIOBB_FLEXSERV_PCZ_STIFFNESS' {
        ext.properties = [eigenvector: 0]
    }
    withName: 'BIOBB_FLEXSERV_PCZ_UNZIP' {
        ext.properties = [pdb: false]
    }
    withName: 'BIOBB_FLEXSERV_PCZ_ZIP' {
        ext.properties = [variance: 90]
    }
}

trace {
    enabled = true
    file = 'tests_trace.tsv'
    overwrite = true
    fields = 'process,tag,status,exit,realtime'
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    apptainer {
        apptainer.enabled = true
    }
}
