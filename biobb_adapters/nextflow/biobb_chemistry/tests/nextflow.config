// Generated by utils_biobb nextflow_generator.py from the JSON schemas: do not edit by hand.
// Test settings of biobb_chemistry: properties and outputs of biobb_chemistry/test/conf.yml

process {
    errorStrategy = 'ignore'
    time = '1h'
    withName: 'BIOBB_CHEMISTRY_ACPYPE_CONVERT_AMBER_TO_GMX' {
        ext.properties = [basename: 'BBB']
    }
    withName: 'BIOBB_CHEMISTRY_ACPYPE_PARAMS_AC' {
        ext.properties = [basename: 'BBB', charge: 0]
    }
    withName: 'BIOBB_CHEMISTRY_ACPYPE_PARAMS_CNS' {
        ext.properties = [basename: 'BBB', charge: 0]
    }
    withName: 'BIOBB_CHEMISTRY_ACPYPE_PARAMS_GMX' {
        ext.properties = [basename: 'BBB', charge: 0]
    }
    withName: 'BIOBB_CHEMISTRY_ACPYPE_PARAMS_GMX_OPLS' {
        ext.properties = [basename: 'BBB', charge: 0]
    }
    withName: 'BIOBB_CHEMISTRY_BABEL_ADD_HYDROGENS' {
        ext.properties = [input_format: 'pdb', output_format: 'pdb', coordinates: 3, ph: 7.4]
        ext.outputs = [output_path: 'pdb']
    }
    withName: 'BIOBB_CHEMISTRY_BABEL_CONVERT' {
        ext.properties = [input_format: 'smi', output_format: 'mol2', coordinates: 2, ph: 7.4]
        ext.outputs = [output_path: 'mol2']
    }
    withName: 'BIOBB_CHEMISTRY_BABEL_MINIMIZE' {
        ext.properties = [criteria: '1e-6', method: 'cg', force_field: 'GAFF', hydrogens: true, steps: 2500, cutoff: true, rvdw: 6.0, rele: 10.0, frequency: 10]
    }
    withName: 'BIOBB_CHEMISTRY_BABEL_REMOVE_HYDROGENS' {
        ext.properties = [input_format: 'pdb', output_format: 'pdb', coordinates: 3, ph: 7.4]
        ext.outputs = [output_path: 'pdb']
    }
    withName: 'BIOBB_CHEMISTRY_REDUCE_ADD_HYDROGENS' {
        ext.properties = [nooh: true]
    }
    withName: 'BIOBB_CHEMISTRY_REDUCE_REMOVE_HYDROGENS' {
        ext.properties = [remove_tmp: false]
    }
}

trace {
    enabled = true
    file = 'tests_trace.tsv'
    overwrite = true
    fields = 'process,tag,status,exit,realtime'
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    apptainer {
        apptainer.enabled = true
    }
}
