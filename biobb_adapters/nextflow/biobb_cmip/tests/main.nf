include { BIOBB_CMIP_CMIP_IGNORE_RESIDUES } from '../cmip_ignore_residues'
include { BIOBB_CMIP_CMIP_PREPARE_PDB } from '../cmip_prepare_pdb'
include { BIOBB_CMIP_CMIP_PREPARE_STRUCTURE } from '../cmip_prepare_structure'
include { BIOBB_CMIP_CMIP_RUN } from '../cmip_run'
include { BIOBB_CMIP_CMIP_TITRATION } from '../cmip_titration'

params {
    test_data: String = "${projectDir}/../../../../../biobb_cmip/biobb_cmip/test"
}

workflow {
    main:
    BIOBB_CMIP_CMIP_IGNORE_RESIDUES(channel.of([[id: 'cmip_ignore_residues'], file("${params.test_data}/data/cmip/input_ignore_res.pdb")]))
    BIOBB_CMIP_CMIP_PREPARE_PDB(channel.of([[id: 'cmip_prepare_pdb'], file("${params.test_data}/data/cmip/1aki.pdb")]))
    BIOBB_CMIP_CMIP_PREPARE_STRUCTURE(channel.of([[id: 'cmip_prepare_structure'], file("${params.test_data}/data/cmip/1aki.pdb"), []]))
    BIOBB_CMIP_CMIP_RUN(channel.of([[id: 'cmip_run'], file("${params.test_data}/data/cmip/RBD-hACE2.hACE2.cmip.pdb"), file("${params.test_data}/data/cmip/RBD-hACE2.RBD.cmip.pdb"), [], [], [], [], []]))
    BIOBB_CMIP_CMIP_TITRATION(channel.of([[id: 'cmip_titration'], file("${params.test_data}/data/cmip/1kim_h.pdb"), [], []]))

    def expected = [
        'cmip_ignore_residues.output_cmip_pdb_path',
        'cmip_prepare_pdb.output_cmip_pdb_path',
        'cmip_prepare_structure.output_cmip_pdb_path',
        'cmip_run.output_byat_path',
        'cmip_titration.output_pdb_path'
    ]
    channel.empty()
        .mix(
            BIOBB_CMIP_CMIP_IGNORE_RESIDUES.out.output_cmip_pdb_path.map { meta, _file -> meta.id + '.output_cmip_pdb_path' },
            BIOBB_CMIP_CMIP_PREPARE_PDB.out.output_cmip_pdb_path.map { meta, _file -> meta.id + '.output_cmip_pdb_path' },
            BIOBB_CMIP_CMIP_PREPARE_STRUCTURE.out.output_cmip_pdb_path.map { meta, _file -> meta.id + '.output_cmip_pdb_path' },
            BIOBB_CMIP_CMIP_RUN.out.output_pdb_path.map { meta, _file -> meta.id + '.output_pdb_path' },
            BIOBB_CMIP_CMIP_RUN.out.output_grd_path.map { meta, _file -> meta.id + '.output_grd_path' },
            BIOBB_CMIP_CMIP_RUN.out.output_cube_path.map { meta, _file -> meta.id + '.output_cube_path' },
            BIOBB_CMIP_CMIP_RUN.out.output_rst_path.map { meta, _file -> meta.id + '.output_rst_path' },
            BIOBB_CMIP_CMIP_RUN.out.output_byat_path.map { meta, _file -> meta.id + '.output_byat_path' },
            BIOBB_CMIP_CMIP_RUN.out.output_log_path.map { meta, _file -> meta.id + '.output_log_path' },
            BIOBB_CMIP_CMIP_RUN.out.output_json_box_path.map { meta, _file -> meta.id + '.output_json_box_path' },
            BIOBB_CMIP_CMIP_RUN.out.output_json_external_box_path.map { meta, _file -> meta.id + '.output_json_external_box_path' },
