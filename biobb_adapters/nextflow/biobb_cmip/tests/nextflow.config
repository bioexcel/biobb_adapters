// Generated by utils_biobb nextflow_generator.py from the JSON schemas: do not edit by hand.
// Test settings of biobb_cmip: properties and outputs of biobb_cmip/test/conf.yml

process {
    errorStrategy = 'ignore'
    time = '1h'
    withName: 'BIOBB_CMIP_CMIP_IGNORE_RESIDUES' {
        ext.properties = [residue_list: 3]
    }
    withName: 'BIOBB_CMIP_CMIP_PREPARE_PDB' {
        ext.properties = [remove_tmp: true]
    }
    withName: 'BIOBB_CMIP_CMIP_PREPARE_STRUCTURE' {
        ext.properties = [remove_tmp: true]
    }
    withName: 'BIOBB_CMIP_CMIP_RUN' {
        ext.properties = [execution_type: 'pb_interaction_energy']
        ext.outputs = [output_byat_path: 'out']
    }
    withName: 'BIOBB_CMIP_CMIP_TITRATION' {
        ext.properties = [neutral: true]
    }
}

trace {
    enabled = true
    file = 'tests_trace.tsv'
    overwrite = true
    fields = 'process,tag,status,exit,realtime'
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    apptainer {
        apptainer.enabled = true
    }
}
