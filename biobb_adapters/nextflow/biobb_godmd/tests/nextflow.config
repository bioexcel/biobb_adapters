// Generated by utils_biobb nextflow_generator.py from the JSON schemas: do not edit by hand.
// Test settings of biobb_godmd: properties and outputs of biobb_godmd/test/conf.yml

process {
    errorStrategy = 'ignore'
    time = '1h'
    withName: 'BIOBB_GODMD_GODMD_PREP' {
        ext.properties = [gapopen: '12.0', gapextend: '2']
    }
    withName: 'BIOBB_GODMD_GODMD_RUN' {
        ext.properties = [remove_tmp: true]
        ext.outputs = [output_ene_path: 'out', output_trj_path: 'mdcrd']
    }
}

trace {
    enabled = true
    file = 'tests_trace.tsv'
    overwrite = true
    fields = 'process,tag,status,exit,realtime'
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    apptainer {
        apptainer.enabled = true
    }
}
