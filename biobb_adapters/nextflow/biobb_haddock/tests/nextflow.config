// Generated by utils_biobb nextflow_generator.py from the JSON schemas: do not edit by hand.
// Test settings of biobb_haddock: properties and outputs of biobb_haddock/test/conf.yml

process {
    errorStrategy = 'ignore'
    time = '1h'
    withName: 'BIOBB_HADDOCK_ANARCII' {
        ext.properties = [remove_tmp: false]
    }
    withName: 'BIOBB_HADDOCK_CAPRI_EVAL' {
        ext.properties = [remove_tmp: false]
        ext.outputs = [output_evaluation_zip_path: 'zip']
    }
    withName: 'BIOBB_HADDOCK_CLUST_FCC' {
        ext.properties = [remove_tmp: false]
        ext.outputs = [output_cluster_zip_path: 'zip']
    }
    withName: 'BIOBB_HADDOCK_CONTACT_MAP' {
        ext.properties = [remove_tmp: false]
        ext.outputs = [output_contactmap_zip_path: 'zip']
    }
    withName: 'BIOBB_HADDOCK_EM_REF' {
        ext.properties = [remove_tmp: false]
        ext.outputs = [refinement_output_zip_path: 'zip']
    }
    withName: 'BIOBB_HADDOCK_FLEX_REF' {
        ext.properties = [remove_tmp: false]
        ext.outputs = [refinement_output_zip_path: 'zip']
    }
    withName: 'BIOBB_HADDOCK_HADDOCK3_ACCESSIBILITY' {
        ext.properties = [remove_tmp: false]
        ext.outputs = [output_actpass_path: 'txt']
    }
    withName: 'BIOBB_HADDOCK_HADDOCK3_ACTPASS_TO_AMBIG' {
        ext.properties = [remove_tmp: false]
    }
    withName: 'BIOBB_HADDOCK_HADDOCK3_EXTEND' {
        ext.properties = [remove_tmp: false]
    }
    withName: 'BIOBB_HADDOCK_HADDOCK3_PASSIVE_FROM_ACTIVE' {
        ext.properties = [remove_tmp: false, active_list: '27,73,83,87']
    }
    withName: 'BIOBB_HADDOCK_HADDOCK3_RESTRAIN_BODIES' {
        ext.properties = [remove_tmp: false]
    }
    withName: 'BIOBB_HADDOCK_HADDOCK3_RUN' {
        ext.properties = [remove_tmp: false]
    }
    withName: 'BIOBB_HADDOCK_RIGID_BODY' {
        ext.properties = [remove_tmp: false]
    }
    withName: 'BIOBB_HADDOCK_SELE_TOP' {
        ext.properties = [remove_tmp: false]
        ext.outputs = [output_selection_zip_path: 'zip']
    }
    withName: 'BIOBB_HADDOCK_SELE_TOP_CLUSTS' {
        ext.properties = [remove_tmp: false]
        ext.outputs = [output_selection_zip_path: 'zip']
    }
    withName: 'BIOBB_HADDOCK_TOPOLOGY' {
        ext.properties = [remove_tmp: false]
        ext.outputs = [mol1_output_top_zip_path: 'zip', mol2_output_top_zip_path: 'zip']
    }
}

trace {
    enabled = true
    file = 'tests_trace.tsv'
    overwrite = true
    fields = 'process,tag,status,exit,realtime'
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    apptainer {
        apptainer.enabled = true
    }
}
