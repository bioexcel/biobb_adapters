// Generated by utils_biobb nextflow_generator.py from the JSON schemas: do not edit by hand.
// Test settings of biobb_structure_utils: properties and outputs of biobb_structure_utils/test/conf.yml

process {
    errorStrategy = 'ignore'
    time = '1h'
    withName: 'BIOBB_STRUCTURE_UTILS_CAT_PDB' {
        ext.properties = [remove_tmp: true]
    }
    withName: 'BIOBB_STRUCTURE_UTILS_CLOSEST_RESIDUES' {
        ext.properties = [residues: [[name: 'HIS', model: '1'], 580, 61], radius: 5]
    }
    withName: 'BIOBB_STRUCTURE_UTILS_EXTRACT_ATOMS' {
        ext.properties = [regular_expression_pattern: 'OE2']
    }
    withName: 'BIOBB_STRUCTURE_UTILS_EXTRACT_CHAIN' {
        ext.properties = [permissive: true, chains: ['B', 'C']]
    }
    withName: 'BIOBB_STRUCTURE_UTILS_EXTRACT_HETEROATOMS' {
        ext.properties = [heteroatoms: [[name: 'TA1', model: '1'], [name: 'ADP']]]
    }
    withName: 'BIOBB_STRUCTURE_UTILS_EXTRACT_MODEL' {
        ext.properties = [models: [1, 4]]
    }
    withName: 'BIOBB_STRUCTURE_UTILS_EXTRACT_MOLECULE' {
        ext.properties = [remove_tmp: true]
    }
    withName: 'BIOBB_STRUCTURE_UTILS_EXTRACT_RESIDUES' {
        ext.properties = [residues: [[name: 'HIS', model: '1'], 61]]
    }
    withName: 'BIOBB_STRUCTURE_UTILS_REMOVE_LIGAND' {
        ext.properties = [ligand: 'AQ4']
    }
    withName: 'BIOBB_STRUCTURE_UTILS_REMOVE_MOLECULES' {
        ext.properties = [molecules: [[name: 'HIS', model: '1'], 61]]
    }
    withName: 'BIOBB_STRUCTURE_UTILS_REMOVE_PDB_WATER' {
        ext.properties = [remove_tmp: true]
    }
    withName: 'BIOBB_STRUCTURE_UTILS_RENUMBER_STRUCTURE' {
        ext.properties = [renumber_residues: true]
    }
    withName: 'BIOBB_STRUCTURE_UTILS_SORT_GRO_RESIDUES' {
        ext.properties = [residue_name_list: ['NA', 'CL', 'SOL']]
    }
    withName: 'BIOBB_STRUCTURE_UTILS_STR_CHECK_ADD_HYDROGENS' {
        ext.properties = [mode: 'auto', charges: true, keep_canonical_resnames: true]
        ext.outputs = [output_structure_path: 'pdbqt']
    }
    withName: 'BIOBB_STRUCTURE_UTILS_STRUCTURE_CHECK' {
        ext.properties = [features: ['chains', 'models']]
    }
}

trace {
    enabled = true
    file = 'tests_trace.tsv'
    overwrite = true
    fields = 'process,tag,status,exit,realtime'
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    apptainer {
        apptainer.enabled = true
    }
}
