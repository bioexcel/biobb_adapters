// Generated by utils_biobb nextflow_generator.py from the JSON schemas: do not edit by hand.
// Test settings of biobb_pmx: properties and outputs of biobb_pmx/test/conf.yml

process {
    errorStrategy = 'ignore'
    time = '1h'
    withName: 'BIOBB_PMX_PMXANALYSE' {
        ext.properties = [method: 'CGI BAR JARZ', temperature: 298.15, dpi: 600]
    }
    withName: 'BIOBB_PMX_PMXATOM_MAPPING' {
        ext.properties = [noalignment: false, distance: 0.05]
    }
    withName: 'BIOBB_PMX_PMXCREATE_TOP' {
        ext.properties = [force_field: 'amber99sb-star-ildn-mut.ff', water: 'spce', system_name: 'Pmx topology BioBB Tutorial', mols: [['MOL', 1]]]
    }
    withName: 'BIOBB_PMX_PMXGENTOP' {
        ext.properties = [force_field: 'amber99sb-star-ildn-mut']
    }
    withName: 'BIOBB_PMX_PMXLIGAND_HYBRID' {
        ext.properties = [fit: true, distance: 0.05]
    }
    withName: 'BIOBB_PMX_PMXMERGE_FF' {
        ext.properties = [remove_tmp: true]
    }
    withName: 'BIOBB_PMX_PMXMUTATE' {
        ext.properties = [mutation_list: '10Ala', force_field: 'amber99sb-star-ildn-mut']
    }
}

trace {
    enabled = true
    file = 'tests_trace.tsv'
    overwrite = true
    fields = 'process,tag,status,exit,realtime'
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    apptainer {
        apptainer.enabled = true
    }
}
