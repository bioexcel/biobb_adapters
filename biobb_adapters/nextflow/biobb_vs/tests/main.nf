params {
    test_data: String = "${projectDir}/../../../../../biobb_vs/biobb_vs/test"
}

workflow {
    main:
    BIOBB_VS_AUTODOCK_VINA_RUN(channel.of([[id: 'autodock_vina_run'], file("${params.test_data}/data/vina/vina_ligand.pdbqt"), file("${params.test_data}/data/vina/vina_receptor.pdbqt"), file("${params.test_data}/data/vina/vina_box.pdb")]))
