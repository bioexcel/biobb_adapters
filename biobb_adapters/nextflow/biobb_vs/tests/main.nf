include { BIOBB_VS_BINDINGSITE } from '../bindingsite'
include { BIOBB_VS_BOX } from '../box'
include { BIOBB_VS_BOX_RESIDUES } from '../box_residues'
include { BIOBB_VS_EXTRACT_MODEL_PDBQT } from '../extract_model_pdbqt'
include { BIOBB_VS_FPOCKET_FILTER } from '../fpocket_filter'
include { BIOBB_VS_FPOCKET_RUN } from '../fpocket_run'
