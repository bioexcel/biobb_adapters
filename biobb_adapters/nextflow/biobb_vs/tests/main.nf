    BIOBB_VS_BOX(channel.of([[id: 'box'], file("${params.test_data}/data/utils/input_box.pqr")]))
    BIOBB_VS_BOX_RESIDUES(channel.of([[id: 'box_residues'], file("${params.test_data}/data/utils/input_box_residues.pdb")]))
    BIOBB_VS_EXTRACT_MODEL_PDBQT(channel.of([[id: 'extract_model_pdbqt'], file("${params.test_data}/data/utils/models.pdbqt")]))
    BIOBB_VS_FPOCKET_FILTER(channel.of([[id: 'fpocket_filter'], file("${params.test_data}/data/fpocket/input_pockets.zip"), file("${params.test_data}/data/fpocket/input_summary.json")]))
    BIOBB_VS_FPOCKET_RUN(channel.of([[id: 'fpocket_run'], file("${params.test_data}/data/fpocket/fpocket_input.pdb")]))
    BIOBB_VS_FPOCKET_SELECT(channel.of([[id: 'fpocket_select'], file("${params.test_data}/data/fpocket/input_pockets.zip")]))

    def expected = [
