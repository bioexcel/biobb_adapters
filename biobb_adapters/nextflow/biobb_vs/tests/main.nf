        'fpocket_run.output_summary',
        'fpocket_select.output_pocket_pdb',
        'fpocket_select.output_pocket_pqr'
    ]
    channel.empty()
        .mix(
            BIOBB_VS_AUTODOCK_VINA_RUN.out.output_pdbqt_path.map { meta, _file -> meta.id + '.output_pdbqt_path' },
            BIOBB_VS_AUTODOCK_VINA_RUN.out.output_log_path.map { meta, _file -> meta.id + '.output_log_path' },
