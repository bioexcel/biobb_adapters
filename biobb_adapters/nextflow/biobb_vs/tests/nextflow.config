// Generated by utils_biobb nextflow_generator.py from the JSON schemas: do not edit by hand.
// Test settings of biobb_vs: properties and outputs of biobb_vs/test/conf.yml

process {
    errorStrategy = 'ignore'
    time = '1h'
    withName: 'BIOBB_VS_AUTODOCK_VINA_RUN' {
        ext.properties = [remove_tmp: true]
        ext.outputs = [output_log_path: 'log']
    }
    withName: 'BIOBB_VS_BINDINGSITE' {
        ext.properties = [ligand: 'PGA', matrix_name: 'BLOSUM62', gap_open: -10.0, gap_extend: -0.5, max_num_ligands: 15, radius: 5]
    }
    withName: 'BIOBB_VS_BOX' {
        ext.properties = [offset: 2, box_coordinates: true]
    }
    withName: 'BIOBB_VS_BOX_RESIDUES' {
        ext.properties = [resid_list: [718, 743, 745, 762, 766, 796, 790, 791, 793, 794, 788], offset: 2, box_coordinates: true]
    }
    withName: 'BIOBB_VS_EXTRACT_MODEL_PDBQT' {
        ext.properties = [model: 1]
    }
    withName: 'BIOBB_VS_FPOCKET_FILTER' {
        ext.properties = [score: [0.2, 1], druggability_score: [0.2, 0.9], volume: [100, 600]]
    }
    withName: 'BIOBB_VS_FPOCKET_RUN' {
        ext.properties = [min_radius: 3, max_radius: 6, num_spheres: 35, sort_by: 'druggability_score']
    }
    withName: 'BIOBB_VS_FPOCKET_SELECT' {
        ext.properties = [pocket: 4]
    }
}

trace {
    enabled = true
    file = 'tests_trace.tsv'
    overwrite = true
    fields = 'process,tag,status,exit,realtime'
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    apptainer {
        apptainer.enabled = true
    }
}
