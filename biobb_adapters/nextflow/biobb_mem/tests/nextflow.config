// Generated by utils_biobb nextflow_generator.py from the JSON schemas: do not edit by hand.
// Test settings of biobb_mem: properties and outputs of biobb_mem/test/conf.yml

process {
    errorStrategy = 'ignore'
    time = '1h'
    withName: 'BIOBB_MEM_FATSLIM_APL' {
        ext.properties = [remove_tmp: false, ignore_no_box: true, lipid_selection: '(resname DPPC and name P8)']
    }
    withName: 'BIOBB_MEM_FATSLIM_MEMBRANES' {
        ext.properties = [ignore_no_box: true, remove_tmp: false, selection: '(resname DPPC and name P8)', cutoff: 2.2]
    }
    withName: 'BIOBB_MEM_GORDER_AA' {
        ext.properties = [handle_pbc: false, remove_tmp: false]
    }
    withName: 'BIOBB_MEM_GORDER_CG' {
        ext.properties = [remove_tmp: false]
    }
    withName: 'BIOBB_MEM_GORDER_UA' {
        ext.properties = [handle_pbc: false, remove_tmp: false]
    }
    withName: 'BIOBB_MEM_LPP_ASSIGN_LEAFLETS' {
        ext.properties = [ignore_no_box: true, lipid_sel: '(resname DPPC and name P8)']
    }
    withName: 'BIOBB_MEM_LPP_FLIP_FLOP' {
        ext.properties = [ignore_no_box: true, lipid_sel: '(resname DPPC and name P8)']
    }
    withName: 'BIOBB_MEM_LPP_ZPOSITIONS' {
        ext.properties = [ignore_no_box: true, lipid_sel: '(resname DPPC and name P8)', height_sel: '(resname DPPC and name P8)']
    }
    withName: 'BIOBB_MEM_MDA_HOLE' {
        ext.properties = [select: 'protein', steps: 5]
    }
}

trace {
    enabled = true
    file = 'tests_trace.tsv'
    overwrite = true
    fields = 'process,tag,status,exit,realtime'
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    apptainer {
        apptainer.enabled = true
    }
}
