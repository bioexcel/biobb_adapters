// Generated by utils_biobb nextflow_generator.py from the JSON schemas: do not edit by hand.
// Test settings of biobb_pytorch: properties and outputs of biobb_pytorch/test/conf.yml

process {
    errorStrategy = 'ignore'
    time = '1h'
    withName: 'BIOBB_PYTORCH_BUILD_MODEL' {
        ext.properties = [model_type: 'AutoEncoder', n_cvs: 2, encoder_layers: [16, 8], decoder_layers: [8, 16], options: [norm_in: [mode: 'min_max']]]
        ext.outputs = [output_model_pth_path: 'pth']
    }
    withName: 'BIOBB_PYTORCH_DECODE_MODEL' {
        ext.properties = [Dataset: [batch_size: 32]]
    }
    withName: 'BIOBB_PYTORCH_ENCODE_MODEL' {
        ext.properties = [Dataset: [batch_size: 32]]
    }
    withName: 'BIOBB_PYTORCH_EVALUATE_MODEL' {
        ext.properties = [Dataset: [batch_size: 32]]
    }
    withName: 'BIOBB_PYTORCH_FEAT2TRAJ' {
        ext.outputs = [output_top_path: 'pdb']
    }
    withName: 'BIOBB_PYTORCH_MDFEATURIZER' {
        ext.properties = [cartesian: [selection: 'name CA'], distances: [selection: 'name CA', cutoff: 0.4, periodic: true], options: [norm_in: [mode: 'min_max']]]
    }
    withName: 'BIOBB_PYTORCH_TRAIN_MODEL' {
        ext.properties = [Trainer: [max_epochs: 1, accelerator: 'cpu'], Dataset: [batch_size: 32, split: [train_prop: 0.8, val_prop: 0.2]]]
        ext.outputs = [output_model_pth_path: 'pth', output_metrics_npz_path: 'npz']
    }
}

trace {
    enabled = true
    file = 'tests_trace.tsv'
    overwrite = true
    fields = 'process,tag,status,exit,realtime'
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    apptainer {
        apptainer.enabled = true
    }
}
