// Generated by utils_biobb nextflow_generator.py from the JSON schemas: do not edit by hand.
// Test settings of biobb_flexdyn: properties and outputs of biobb_flexdyn/test/conf.yml

process {
    errorStrategy = 'ignore'
    time = '1h'
    withName: 'BIOBB_FLEXDYN_CONCOORD_DISCO' {
        ext.properties = [vdw: 4, num_structs: 20]
    }
    withName: 'BIOBB_FLEXDYN_CONCOORD_DIST' {
        ext.properties = [vdw: 1, bond_angle: 1]
    }
    withName: 'BIOBB_FLEXDYN_IMOD_IMC' {
        ext.properties = [num_structs: 10, num_modes: 10, amplitude: 6.0]
    }
    withName: 'BIOBB_FLEXDYN_IMOD_IMODE' {
        ext.properties = [cg: 2]
    }
    withName: 'BIOBB_FLEXDYN_IMOD_IMOVE' {
        ext.properties = [pc: 1]
    }
    withName: 'BIOBB_FLEXDYN_NOLB_NMA' {
        ext.properties = [num_structs: 20]
    }
    withName: 'BIOBB_FLEXDYN_PRODY_ANM' {
        ext.properties = [num_structs: 20, rmsd: 4.0]
    }
}

trace {
    enabled = true
    file = 'tests_trace.tsv'
    overwrite = true
    fields = 'process,tag,status,exit,realtime'
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    apptainer {
        apptainer.enabled = true
    }
}
