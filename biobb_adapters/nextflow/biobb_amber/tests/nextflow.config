// Generated by utils_biobb nextflow_generator.py from the JSON schemas: do not edit by hand.
// Test settings of biobb_amber: properties and outputs of biobb_amber/test/conf.yml

process {
    errorStrategy = 'ignore'
    time = '1h'
    withName: 'BIOBB_AMBER_AMBER_TO_PDB' {
        ext.properties = [remove_tmp: true]
    }
    withName: 'BIOBB_AMBER_CESTATS_RUN' {
        ext.properties = [remove_tmp: true]
    }
    withName: 'BIOBB_AMBER_CPHSTATS_RUN' {
        ext.properties = [remove_tmp: true]
    }
    withName: 'BIOBB_AMBER_CPPTRAJ_RANDOMIZE_IONS' {
        ext.properties = [remove_tmp: true]
    }
    withName: 'BIOBB_AMBER_LEAP_ADD_IONS' {
        ext.properties = [forcefield: ['DNA.bsc1'], water_type: 'OPCBOX', ions_type: 'ionsjc_tip4pew', box_type: 'truncated_octahedron', ionic_concentration: 100, positive_ions_type: 'K+']
    }
    withName: 'BIOBB_AMBER_LEAP_BUILD_LINEAR_STRUCTURE' {
        ext.properties = [sequence: 'ALA PRO SER ARG LYS ASP GLU GLY GLY ALA', build_library: false, forcefield: ['protein.ff14SB'], remove_tmp: true]
    }
    withName: 'BIOBB_AMBER_LEAP_GEN_TOP' {
        ext.properties = [forcefield: ['protein.ff14SB'], remove_tmp: true]
    }
    withName: 'BIOBB_AMBER_LEAP_SOLVATE' {
        ext.properties = [forcefield: ['protein.ff14SB'], water_type: 'TIP3PBOX', distance_to_molecule: '9.0', box_type: 'truncated_octahedron', remove_tmp: true]
    }
    withName: 'BIOBB_AMBER_PARMED_CPINUTIL' {
        ext.properties = [igb: 2, resnames: 'AS4 GL4', system: 'cln025', remove_tmp: true]
    }
    withName: 'BIOBB_AMBER_PARMED_HMASSREPARTITION' {
        ext.properties = [remove_tmp: true]
        ext.outputs = [output_top_path: 'prmtop']
    }
    withName: 'BIOBB_AMBER_PDB4AMBER_RUN' {
        ext.properties = [remove_tmp: true]
    }
    withName: 'BIOBB_AMBER_PMEMD_MDRUN' {
        ext.properties = [simulation_type: 'minimization', mdin: [maxcyc: 500, ntwx: 100, ioutfm: 0], remove_tmp: true]
        ext.outputs = [output_traj_path: 'x']
    }
    withName: 'BIOBB_AMBER_PROCESS_MDOUT' {
        ext.properties = [terms: ['TEMP', 'VOLUME', 'EKTOT'], remove_tmp: true]
    }
    withName: 'BIOBB_AMBER_PROCESS_MINOUT' {
        ext.properties = [remove_tmp: true]
    }
    withName: 'BIOBB_AMBER_SANDER_MDRUN' {
        ext.properties = [simulation_type: 'minimization', mdin: [maxcyc: 500, ntwx: 100, ioutfm: 0], remove_tmp: true]
        ext.outputs = [output_traj_path: 'x']
    }
}

trace {
    enabled = true
    file = 'tests_trace.tsv'
    overwrite = true
    fields = 'process,tag,status,exit,realtime'
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    apptainer {
        apptainer.enabled = true
    }
}
