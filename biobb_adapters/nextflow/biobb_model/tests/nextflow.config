// Generated by utils_biobb nextflow_generator.py from the JSON schemas: do not edit by hand.
// Test settings of biobb_model: properties and outputs of biobb_model/test/conf.yml

process {
    errorStrategy = 'ignore'
    time = '1h'
    withName: 'BIOBB_MODEL_CHECKING_LOG' {
        ext.properties = [restart: false]
    }
    withName: 'BIOBB_MODEL_FIX_ALTLOCS' {
        ext.properties = [altlocs: ['A339:A', 'A171:B', 'A768:A']]
    }
    withName: 'BIOBB_MODEL_FIX_AMIDES' {
        ext.properties = [restart: false]
    }
    withName: 'BIOBB_MODEL_FIX_BACKBONE' {
        ext.properties = [restart: false, add_caps: false, modeller_key: 'MODELIRANJE']
    }
    withName: 'BIOBB_MODEL_FIX_CHIRALITY' {
        ext.properties = [restart: false]
    }
    withName: 'BIOBB_MODEL_FIX_PDB' {
        ext.properties = [restart: false, forced_uniprot_references: ['P0DTC2', 'Q9BYF1']]
    }
    withName: 'BIOBB_MODEL_FIX_SIDE_CHAIN' {
        ext.properties = [restart: false]
    }
    withName: 'BIOBB_MODEL_FIX_SSBONDS' {
        ext.properties = [restart: false]
    }
    withName: 'BIOBB_MODEL_MUTATE' {
        ext.properties = [mutation_list: 'Leu49Ile, B:arg51Lys']
    }
}

trace {
    enabled = true
    file = 'tests_trace.tsv'
    overwrite = true
    fields = 'process,tag,status,exit,realtime'
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    apptainer {
        apptainer.enabled = true
    }
}
