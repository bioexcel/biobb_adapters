// Generated by utils_biobb nextflow_generator.py from the JSON schemas: do not edit by hand.
// Test settings of biobb_pdb_tools: properties and outputs of biobb_pdb_tools/test/conf.yml

process {
    errorStrategy = 'ignore'
    time = '1h'
    withName: 'BIOBB_PDB_TOOLS_BIOBB_PDB_CHAIN' {
        ext.properties = [chain: 'A']
    }
    withName: 'BIOBB_PDB_TOOLS_BIOBB_PDB_CHAINXSEG' {
        ext.properties = [remove_tmp: false]
    }
    withName: 'BIOBB_PDB_TOOLS_BIOBB_PDB_DELHETATM' {
        ext.properties = [remove_tmp: false]
    }
    withName: 'BIOBB_PDB_TOOLS_BIOBB_PDB_FETCH' {
        ext.properties = [pdbid: '1nmr', biounit: false]
    }
    withName: 'BIOBB_PDB_TOOLS_BIOBB_PDB_FIXINSERT' {
        ext.properties = [residues: 'B82']
    }
    withName: 'BIOBB_PDB_TOOLS_BIOBB_PDB_MERGE' {
        ext.properties = [remove_tmp: false]
    }
    withName: 'BIOBB_PDB_TOOLS_BIOBB_PDB_MKENSEMBLE' {
        ext.properties = [remove_tmp: false]
    }
    withName: 'BIOBB_PDB_TOOLS_BIOBB_PDB_RERES' {
        ext.properties = [number: 4]
    }
    withName: 'BIOBB_PDB_TOOLS_BIOBB_PDB_SEG' {
        ext.properties = [segment: 'B']
    }
    withName: 'BIOBB_PDB_TOOLS_BIOBB_PDB_SELCHAIN' {
        ext.properties = [chains: 'B']
    }
    withName: 'BIOBB_PDB_TOOLS_BIOBB_PDB_SELMODEL' {
        ext.properties = [models: '1,3']
    }
    withName: 'BIOBB_PDB_TOOLS_BIOBB_PDB_SELRES' {
        ext.properties = [selection: '1:10:2']
    }
    withName: 'BIOBB_PDB_TOOLS_BIOBB_PDB_SPLITMODEL' {
        ext.properties = [remove_tmp: false]
    }
    withName: 'BIOBB_PDB_TOOLS_BIOBB_PDB_SPLITSEG' {
        ext.properties = [remove_tmp: false]
    }
    withName: 'BIOBB_PDB_TOOLS_BIOBB_PDB_TIDY' {
        ext.properties = [strict: false]
    }
    withName: 'BIOBB_PDB_TOOLS_BIOBB_PDB_TOFASTA' {
        ext.properties = [multi: true]
    }
    withName: 'BIOBB_PDB_TOOLS_BIOBB_PDB_UNIQNAME' {
        ext.properties = [remove_tmp: false]
    }
}

trace {
    enabled = true
    file = 'tests_trace.tsv'
    overwrite = true
    fields = 'process,tag,status,exit,realtime'
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    apptainer {
        apptainer.enabled = true
    }
}
