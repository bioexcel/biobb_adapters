// Generated by utils_biobb nextflow_generator.py from the JSON schemas: do not edit by hand.
// Test settings of biobb_dna: properties and outputs of biobb_dna/test/conf.yml

process {
    errorStrategy = 'ignore'
    time = '1h'
    withName: 'BIOBB_DNA_AVERAGE_STIFFNESS' {
        ext.properties = [sequence: 'CGCGAATTCGCG']
    }
    withName: 'BIOBB_DNA_BASEPAIR_STIFFNESS' {
        ext.properties = [remove_tmp: false]
    }
    withName: 'BIOBB_DNA_BIOBB_CANAL' {
        ext.properties = [series: true, histo: true, corr: true, sequence: 'CGCGAATTCGCG']
    }
    withName: 'BIOBB_DNA_BIOBB_CANION' {
        ext.properties = [dlow: 5.8, dhig: 7.2, type: 'K+', rlow: 0, rhig: 18]
    }
    withName: 'BIOBB_DNA_BIOBB_CURVES' {
        ext.properties = [s1range: '1:12', ions: true]
        ext.outputs = [output_zip_path: 'zip']
    }
    withName: 'BIOBB_DNA_BIPOPULATIONS' {
        ext.properties = [sequence: 'CGCGAATTCGCG']
    }
    withName: 'BIOBB_DNA_CANAL_UNZIP' {
        ext.properties = [type: 'histo', helpar_name: 'alphaC']
        ext.outputs = [output_list_path: 'txt']
    }
    withName: 'BIOBB_DNA_CANONICALAG' {
        ext.properties = [sequence: 'CGCGAATTCGCG']
    }
    withName: 'BIOBB_DNA_DNA_AVERAGES' {
        ext.properties = [sequence: 'CGCGAATTCGCG', seqpos: [4, 5, 6], stride: 1]
    }
    withName: 'BIOBB_DNA_DNA_BIMODALITY' {
        ext.properties = [helpar_name: 'shift', confidence_level: 5.0, max_iter: 400, tol: 1e-05]
    }
    withName: 'BIOBB_DNA_DNA_TIMESERIES' {
        ext.properties = [sequence: 'CGCGAATTCGCG', seqpos: [4, 5]]
    }
    withName: 'BIOBB_DNA_DNA_TIMESERIES_UNZIP' {
        ext.properties = [type: 'hist', parameter: 'shift', sequence: 'CGCGAATTCGCG', index: 5]
        ext.outputs = [output_list_path: 'txt']
    }
    withName: 'BIOBB_DNA_INTERBPCORR' {
        ext.properties = [sequence: 'CGCGAATTCGCG']
    }
    withName: 'BIOBB_DNA_INTERHPCORR' {
        ext.properties = [remove_tmp: false]
    }
    withName: 'BIOBB_DNA_INTERSEQCORR' {
        ext.properties = [sequence: 'CGCGAATTCGCG']
    }
    withName: 'BIOBB_DNA_INTRABPCORR' {
        ext.properties = [sequence: 'CGCGAATTCGCG']
    }
    withName: 'BIOBB_DNA_INTRAHPCORR' {
        ext.properties = [remove_tmp: false]
    }
    withName: 'BIOBB_DNA_INTRASEQCORR' {
        ext.properties = [sequence: 'CGCGAATTCGCG']
    }
    withName: 'BIOBB_DNA_PUCKERING' {
        ext.properties = [sequence: 'CGCGAATTCGCG']
    }
}

trace {
    enabled = true
    file = 'tests_trace.tsv'
    overwrite = true
    fields = 'process,tag,status,exit,realtime'
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    apptainer {
        apptainer.enabled = true
    }
}
