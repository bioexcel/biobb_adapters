// Generated by utils_biobb nextflow_generator.py from the JSON schemas: do not edit by hand.
// Test settings of biobb_cp2k: properties and outputs of biobb_cp2k/test/conf.yml

process {
    errorStrategy = 'ignore'
    time = '1h'
    withName: 'BIOBB_CP2K_CP2K_PREP' {
        ext.properties = [simulation_type: 'energy']
    }
    withName: 'BIOBB_CP2K_CP2K_RUN' {
        ext.properties = [remove_tmp: true]
    }
}

trace {
    enabled = true
    file = 'tests_trace.tsv'
    overwrite = true
    fields = 'process,tag,status,exit,realtime'
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    apptainer {
        apptainer.enabled = true
    }
}
