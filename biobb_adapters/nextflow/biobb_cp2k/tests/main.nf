/*
 * Generated by utils_biobb nextflow_generator.py from the JSON schemas: do not edit by hand.
 * Tests of the biobb_cp2k Nextflow modules: runs every block once with the inputs, properties and outputs
 * of biobb_cp2k/test/conf.yml, writes tests_report.tsv and fails if an expected output is missing.
 * Usage: nextflow run main.nf [-profile docker|apptainer] [--test_data <biobb_cp2k/test folder or URL>]
 */

include { BIOBB_CP2K_CP2K_PREP } from '../cp2k_prep'
include { BIOBB_CP2K_CP2K_RUN } from '../cp2k_run'

params {
    test_data: String = "${projectDir}/../../../../../biobb_cp2k/biobb_cp2k/test"
}

workflow {
    main:
    BIOBB_CP2K_CP2K_PREP(channel.of([[id: 'cp2k_prep'], [], file("${params.test_data}/data/cp2k/H2O_box.pdb"), []]))
    BIOBB_CP2K_CP2K_RUN(channel.of([[id: 'cp2k_run'], file("${params.test_data}/data/cp2k/cp2k_energy.inp")]))

    def expected = [
        'cp2k_prep.output_inp_path',
        'cp2k_run.output_log_path',
        'cp2k_run.output_outzip_path',
        'cp2k_run.output_rst_path'
    ]
    channel.empty()
        .mix(
            BIOBB_CP2K_CP2K_PREP.out.output_inp_path.map { meta, _file -> meta.id + '.output_inp_path' },
            BIOBB_CP2K_CP2K_RUN.out.output_log_path.map { meta, _file -> meta.id + '.output_log_path' },
            BIOBB_CP2K_CP2K_RUN.out.output_outzip_path.map { meta, _file -> meta.id + '.output_outzip_path' },
            BIOBB_CP2K_CP2K_RUN.out.output_rst_path.map { meta, _file -> meta.id + '.output_rst_path' }
        )
        .collect()
        .ifEmpty([])
        .subscribe { produced ->
            def missing = expected - produced
            file("${workflow.launchDir}/tests_report.tsv").text = expected.collect { output -> "${output}\t${output in missing ? 'missing' : 'ok'}" }.join('\n') + '\n'
            if (missing) {
                error("Missing outputs: ${missing.join(', ')}")
            }
            log.info("All ${expected.size()} expected outputs were produced")
        }
}
