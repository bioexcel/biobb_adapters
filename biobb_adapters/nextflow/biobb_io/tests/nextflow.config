// Generated by utils_biobb nextflow_generator.py from the JSON schemas: do not edit by hand.
// Test settings of biobb_io: properties and outputs of biobb_io/test/conf.yml

process {
    errorStrategy = 'ignore'
    time = '1h'
    withName: 'BIOBB_IO_ALPHAFOLD' {
        ext.properties = [uniprot_code: 'P00489']
    }
    withName: 'BIOBB_IO_API_BINDING_SITE' {
        ext.properties = [pdb_code: '4i23']
    }
    withName: 'BIOBB_IO_CANONICAL_FASTA' {
        ext.properties = [pdb_code: '4i23', api_id: 'pdbe']
    }
    withName: 'BIOBB_IO_IDEAL_SDF' {
        ext.properties = [ligand_code: 'HYZ', api_id: 'pdbe']
    }
    withName: 'BIOBB_IO_LIGAND' {
        ext.properties = [ligand_code: 'IBP', api_id: 'pdbe']
    }
    withName: 'BIOBB_IO_MDDB' {
        ext.properties = [project_id: 'A0001', trj_format: 'xtc', frames: '10:20:2', selection: 'backbone and _C']
        ext.outputs = [output_trj_path: 'xtc']
    }
    withName: 'BIOBB_IO_MEMPROTMD_SIM' {
        ext.properties = [pdb_code: '1hzx']
    }
    withName: 'BIOBB_IO_MEMPROTMD_SIM_LIST' {
        ext.properties = [remove_tmp: false]
    }
    withName: 'BIOBB_IO_MEMPROTMD_SIM_SEARCH' {
        ext.properties = [collection_name: 'refs', keyword: 'porin']
    }
    withName: 'BIOBB_IO_MMCIF' {
        ext.properties = [pdb_code: '2VGB', api_id: 'pdbe']
        ext.outputs = [output_mmcif_path: 'mmcif']
    }
    withName: 'BIOBB_IO_PDB' {
        ext.properties = [pdb_code: '2VGB', filter: ['ATOM', 'HETATM'], api_id: 'pdbe']
    }
    withName: 'BIOBB_IO_PDB_CLUSTER_ZIP' {
        ext.properties = [pdb_code: '2vgb', filter: ['ATOM', 'MODEL', 'ENDMDL'], cluster: 90, api_id: 'pdbe']
    }
    withName: 'BIOBB_IO_PDB_VARIANTS' {
        ext.properties = [pdb_code: '2vgb']
    }
    withName: 'BIOBB_IO_STRUCTURE_INFO' {
        ext.properties = [pdb_code: '2VGB']
    }
}

trace {
    enabled = true
    file = 'tests_trace.tsv'
    overwrite = true
    fields = 'process,tag,status,exit,realtime'
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    apptainer {
        apptainer.enabled = true
    }
}
