// Generated by utils_biobb nextflow_generator.py from the JSON schemas: do not edit by hand.
// Test settings of biobb_analysis: properties and outputs of biobb_analysis/test/conf.yml

process {
    errorStrategy = 'ignore'
    time = '1h'
    withName: 'BIOBB_ANALYSIS_CPPTRAJ_AVERAGE' {
        ext.properties = [start: 1, end: -1, steps: 1, mask: 'c-alpha', format: 'pdb']
        ext.outputs = [output_cpptraj_path: 'pdb']
    }
    withName: 'BIOBB_ANALYSIS_CPPTRAJ_BFACTOR' {
        ext.properties = [start: 1, end: -1, steps: 1, mask: 'c-alpha', reference: 'first']
    }
    withName: 'BIOBB_ANALYSIS_CPPTRAJ_CONVERT' {
        ext.properties = [start: 1, end: -1, steps: 1, mask: 'c-alpha', format: 'netcdf']
        ext.outputs = [output_cpptraj_path: 'netcdf']
    }
    withName: 'BIOBB_ANALYSIS_CPPTRAJ_DRY' {
        ext.properties = [start: 1, end: -1, steps: 1, mask: 'c-alpha', format: 'netcdf']
        ext.outputs = [output_cpptraj_path: 'netcdf']
    }
    withName: 'BIOBB_ANALYSIS_CPPTRAJ_IMAGE' {
        ext.properties = [start: 1, end: -1, steps: 1, mask: 'c-alpha', format: 'netcdf']
        ext.outputs = [output_cpptraj_path: 'netcdf']
    }
    withName: 'BIOBB_ANALYSIS_CPPTRAJ_MASK' {
        ext.properties = [start: 1, end: -1, steps: 1, mask: 'c-alpha', format: 'netcdf']
        ext.outputs = [output_cpptraj_path: 'netcdf']
    }
    withName: 'BIOBB_ANALYSIS_CPPTRAJ_RGYR' {
        ext.properties = [start: 1, end: -1, steps: 1, mask: 'c-alpha']
    }
    withName: 'BIOBB_ANALYSIS_CPPTRAJ_RMS' {
        ext.properties = [start: 1, end: -1, steps: 1, mask: 'c-alpha', reference: 'first']
        ext.outputs = [output_traj_path: 'netcdf']
    }
    withName: 'BIOBB_ANALYSIS_CPPTRAJ_RMSF' {
        ext.properties = [start: 1, end: -1, steps: 1, mask: 'c-alpha', reference: 'first']
    }
    withName: 'BIOBB_ANALYSIS_CPPTRAJ_SLICE' {
        ext.properties = [start: 2, end: 20, steps: 2, mask: 'c-alpha', format: 'netcdf']
        ext.outputs = [output_cpptraj_path: 'netcdf']
    }
    withName: 'BIOBB_ANALYSIS_CPPTRAJ_SNAPSHOT' {
        ext.properties = [snapshot: 12, mask: 'c-alpha', format: 'pdb']
        ext.outputs = [output_cpptraj_path: 'pdb']
    }
    withName: 'BIOBB_ANALYSIS_CPPTRAJ_STRIP' {
        ext.properties = [start: 1, end: -1, steps: 1, mask: 'c-alpha', format: 'netcdf']
        ext.outputs = [output_cpptraj_path: 'netcdf']
    }
    withName: 'BIOBB_ANALYSIS_GMX_CHECK' {
        ext.outputs = [output_log_path: 'log']
    }
    withName: 'BIOBB_ANALYSIS_GMX_CLUSTER' {
        ext.properties = [fit_selection: 'System', output_selection: 'System', dista: false, method: 'linkage', cutoff: 0.1]
        ext.outputs = [output_pdb_path: 'pdb']
    }
    withName: 'BIOBB_ANALYSIS_GMX_ENERGY' {
        ext.properties = [terms: ['Potential', 'Pressure']]
    }
    withName: 'BIOBB_ANALYSIS_GMX_IMAGE' {
        ext.properties = [fit_selection: 'System', center_selection: 'System', output_selection: 'System', pbc: 'mol', center: true, fit: 'rot+trans', ur: 'compact']
    }
    withName: 'BIOBB_ANALYSIS_GMX_RGYR' {
        ext.properties = [selection: 'System']
    }
    withName: 'BIOBB_ANALYSIS_GMX_RMS' {
        ext.properties = [selection: 'System']
    }
    withName: 'BIOBB_ANALYSIS_GMX_RMSF' {
        ext.properties = [selection: 'System']
    }
    withName: 'BIOBB_ANALYSIS_GMX_TRJCONV_STR' {
        ext.properties = [selection: 'System']
    }
    withName: 'BIOBB_ANALYSIS_GMX_TRJCONV_STR_ENS' {
        ext.properties = [selection: 'System', start: 0, end: 10, dt: 1, output_name: 'output', output_type: 'pdb']
    }
    withName: 'BIOBB_ANALYSIS_GMX_TRJCONV_TRJ' {
        ext.properties = [selection: 'System', start: 0, end: 0, dt: 0]
    }
}

trace {
    enabled = true
    file = 'tests_trace.tsv'
    overwrite = true
    fields = 'process,tag,status,exit,realtime'
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    apptainer {
        apptainer.enabled = true
    }
}
